function openPortal(role){
 const data=portalTemplates[role];
 if(!data || !portalView || !main) return;

 portalTitle.textContent=data.title;
 portalKicker.textContent=data.kicker;
 portalDescription.textContent=data.description;
 portalContent.innerHTML=data.content;

 main.hidden=true;
 portalView.hidden=false;

 if(modal) modal.classList.remove('show');
 window.scrollTo({top:0,behavior:'instant'});
}

function closePortal(){
 if(portalView) portalView.hidden=true;
 if(main) main.hidden=false;
 window.scrollTo({top:0,behavior:'instant'});
}

document.querySelectorAll('[data-role]').forEach(button=>{
 button.addEventListener('click',()=>{
  openPortal(button.dataset.role);
 });
});

document.querySelector('#portal-back')?.addEventListener('click',closePortal);

document.querySelector('#menu')?.addEventListener('click',()=>{
