let supabaseClient=null;

async function initSupabase(){
 try{
  if(!window.supabase?.createClient){
   throw new Error('کتابخانه Supabase در دسترس نیست.');
  }

  supabaseClient=window.supabase.createClient(
   SUPABASE_URL,
   SUPABASE_PUBLISHABLE_KEY
  );

  const {error}=await supabaseClient.auth.getSession();
  if(error) throw error;

  if(statusEl){
   statusEl.textContent='اتصال به پروژه نیک‌کار برقرار شد';
   statusEl.style.color='#bfe6a7';
  }

 }catch(err){
  if(statusEl){
   statusEl.textContent='اتصال دیتابیس برقرار نشد؛ پنل‌ها در حالت نمایشی هستند';
   statusEl.style.color='#ffb3a8';
  }
  console.warn('Supabase initialization:',err);
 }
}

initSupabase();
